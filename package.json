{
  "name": "bangla-number-words",
  "version": "1.0.0",
  "description": "Convert numbers to Bangla and English words (Bangladeshi/South Asian system), Taka amounts for invoices and cheques, lakh/crore formatting, digit conversion and the Bangla (Bangabda) calendar.",
  "keywords": [
    "bangla",
    "bengali",
    "bangladesh",
    "number-to-words",
    "taka",
    "lakh",
    "crore",
    "bangla-calendar"
  ],
  "author": "Saizul Amin <https://saizul.com>",
  "license": "MIT",
  "homepage": "https://saizul.com",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
